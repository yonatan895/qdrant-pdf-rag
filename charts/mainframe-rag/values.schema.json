{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mainframe-rag values",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "images", "qdrantRelease", "models", "gateway", "tracing", "metrics", "route", "storage", "ingest", "pullSecret", "resources"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "ingest", "jaeger", "oauthProxy"],
      "properties": {
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag"],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "not": { "pattern": "__[A-Z0-9_]+__" }
            },
            "tag": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$",
              "description": "Full git SHA; deploy.sh fail-closes on empty/HEAD."
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "ingest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag"],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "not": { "pattern": "__[A-Z0-9_]+__" }
            },
            "tag": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$",
              "description": "Packed SHA; the generator sets agent and ingest tags from IMAGE_SHA."
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "jaeger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag"],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "not": { "pattern": "__[A-Z0-9_]+__" }
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "not": { "pattern": "__[A-Z0-9_]+__" }
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "oauthProxy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag"],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "not": { "pattern": "__[A-Z0-9_]+__" }
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "not": { "pattern": "__[A-Z0-9_]+__" }
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        }
      }
    },
    "qdrantRelease": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "description": "Single owner for the in-cluster URL and chart-managed Secret name."
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["embedding", "reasoning", "rerank"],
      "properties": {
        "embedding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseUrl", "model", "revision", "dimension"],
          "properties": {
            "baseUrl": {
              "type": "string",
              "pattern": "^https?://\\S+$"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "not": { "pattern": "__[A-Z0-9_]+__" }
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*",
              "not": { "pattern": "__[A-Z0-9_]+__" }
            },
            "dimension": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "reasoning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseUrl": { "type": "string" },
            "model": { "type": "string" },
            "condenseEnabled": { "type": "boolean" }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "model": { "minLength": 1, "pattern": ".*\\S.*" }
                },
                "required": ["model"]
              },
              "then": {
                "properties": {
                  "baseUrl": { "pattern": "^https?://\\S+$" }
                },
                "required": ["baseUrl"]
              }
            },
            {
              "if": {
                "properties": {
                  "baseUrl": { "minLength": 1, "pattern": ".*\\S.*" }
                },
                "required": ["baseUrl"]
              },
              "then": {
                "properties": {
                  "model": { "minLength": 1, "pattern": ".*\\S.*" }
                },
                "required": ["model"]
              }
            }
          ]
        },
        "rerank": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "model", "endpointOrder"],
          "properties": {
            "enabled": { "type": "boolean" },
            "baseUrl": {
              "type": "string",
              "description": "Empty falls back to the embedding URL (HttpReranker)."
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "not": { "pattern": "__[A-Z0-9_]+__" }
            },
            "endpointOrder": {
              "type": "string",
              "enum": ["score_first", "rerank_first"]
            }
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiKeySecretName"],
      "properties": {
        "apiKeySecretName": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "description": "Secret name only; values never carry key material (D7)."
        },
        "caConfigMapName": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "description": "Optional trust bundle ConfigMap; empty disables the mount."
        }
      }
    },
    "tracing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "endpoint": { "type": "string" },
        "deploymentEnvironment": { "type": "string" },
        "serviceName": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9._-]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": {
            "properties": {
              "endpoint": { "pattern": "^https?://\\S+$" }
            },
            "required": ["endpoint"]
          }
        }
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "timeoutSeconds"],
      "properties": {
        "enabled": { "type": "boolean" },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "destinationCA": {
          "type": "string",
          "description": "Namespace service-CA bundle (non-secret generated value, D8)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": {
            "properties": {
              "destinationCA": { "minLength": 1, "pattern": ".*\\S.*" }
            },
            "required": ["destinationCA"]
          }
        }
      ]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["className"],
      "properties": {
        "className": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "__[A-Z0-9_]+__" },
          "description": "RWO block storage class; NFS refusal stays owned by shell preflight."
        }
      },
      "not": {
        "properties": {
          "className": { "pattern": "[Nn][Ff][Ss]" }
        }
      }
    },
    "ingest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "workers", "aliasPublish", "reingest", "collectionPolicy"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "True renders the explicit Job; steady-state releases use false (D3)."
        },
        "corpusPVC": {
          "type": "string",
          "description": "Caller-supplied corpus PVC; required when enabled."
        },
        "workSize": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$" },
        "workers": {
          "type": "integer",
          "minimum": 1
        },
        "aliasPublish": { "type": "boolean" },
        "reingest": { "type": "boolean" },
        "retireDocs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\"\\\\*?]+$",
            "not": { "pattern": "__[A-Z0-9_]+__" }
          },
          "description": "Malformed @-sides, control characters and backend inventory checks stay shell-owned (D6)."
        },
        "contextualEnabled": { "type": "boolean" },
        "contextLlmBaseUrl": { "type": "string" },
        "contextLlmModel": { "type": "string" },
        "collectionPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shardNumber", "replicationFactor", "writeConsistencyFactor"],
          "properties": {
            "shardNumber": { "type": "integer", "minimum": 1 },
            "replicationFactor": { "type": "integer", "minimum": 1 },
            "writeConsistencyFactor": { "type": "integer", "minimum": 1 }
          },
          "description": "W<=RF validation stays owned by validate_collection_policy in shell (D6)."
        },
        "resources": {
          "type": "object",
          "description": "Kubernetes resource requests/limits for the ingest container."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": {
            "properties": {
              "corpusPVC": { "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$" }
            },
            "required": ["corpusPVC"]
          }
        },
        {
          "if": {
            "properties": { "retireDocs": { "minItems": 1 } },
            "required": ["retireDocs"]
          },
          "then": {
            "properties": { "aliasPublish": { "const": true } }
          }
        }
      ]
    },
    "pullSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent"],
      "properties": {
        "agent": {
          "type": "object",
          "description": "Kubernetes resource requests/limits for the agent container."
        }
      }
    }
  }
}
