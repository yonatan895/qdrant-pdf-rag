{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mainframe-rag values",
  "type": "object",
  "additionalProperties": false,
  "if": {
    "properties": { "requestMaxConcurrent": { "exclusiveMinimum": 0 } },
    "required": ["requestMaxConcurrent"]
  },
  "then": {
    "required": ["requestQueueWaitSeconds"],
    "properties": { "requestQueueWaitSeconds": { "exclusiveMinimum": 0 } }
  },
  "required": ["replicaCount", "images", "qdrantRelease", "models", "gateway", "tracing", "metrics", "ui", "route", "storage", "ingest", "pullSecret", "resources"],
  "definitions": {
    "nonPlaceholderString": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "__[A-Z0-9_]+__" }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "$ref": "#/definitions/nonPlaceholderString" },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Verified registry manifest digest; when set the pod image is repository@digest (the tag stays informational)."
        },
        "tag": { "$ref": "#/definitions/nonPlaceholderString" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "appImage": {
      "allOf": [
        { "$ref": "#/definitions/image" },
        {
          "properties": {
            "tag": {
              "pattern": "^[0-9a-f]{40}$",
              "description": "Full git SHA; deploy.sh fail-closes on empty/HEAD. The generator sets agent and ingest tags from IMAGE_SHA."
            }
          }
        }
      ]
    }
  },
  "properties": {
    "requestDeadlineSeconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
    "requestMaxConcurrent": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "requestQueueMax": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "requestQueueWaitSeconds": { "type": "number", "minimum": 0, "maximum": 300 },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "ingest", "oauthProxy"],
      "properties": {
        "agent": { "$ref": "#/definitions/appImage" },
        "ingest": { "$ref": "#/definitions/appImage" },
        "oauthProxy": { "$ref": "#/definitions/image" },
        "openobserve": { "$ref": "#/definitions/image" },
        "otelcol": { "$ref": "#/definitions/image" },
        "openwebui": { "$ref": "#/definitions/image" },
        "openwebuiProxy": { "$ref": "#/definitions/image" }
      }
    },
    "qdrantRelease": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "description": "Single owner for the in-cluster URL and chart-managed Secret name."
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["embedding", "reasoning", "rerank"],
      "properties": {
        "embedding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseUrl", "model", "revision", "dimension"],
          "properties": {
            "baseUrl": {
              "type": "string",
              "pattern": "^https?://\\S+$"
            },
            "model": { "$ref": "#/definitions/nonPlaceholderString" },
            "revision": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*",
              "not": { "pattern": "__[A-Z0-9_]+__" }
            },
            "dimension": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "reasoning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseUrl": { "type": "string" },
            "model": { "type": "string" },
            "condenseEnabled": { "type": "boolean" },
            "maxModelLen": { "type": "integer", "minimum": 512, "maximum": 131072 },
            "reservedOutputTokens": { "type": "integer", "minimum": 128, "maximum": 16384 },
            "thinkingReserveTokensSimple": { "type": "integer", "minimum": 0, "maximum": 16384 },
            "thinkingReserveTokensComplex": { "type": "integer", "minimum": 0, "maximum": 16384 },
            "reasoningEffortSimple": { "type": "string", "enum": ["low", "medium", "high", "xhigh"] },
            "reasoningEffortComplex": { "type": "string", "enum": ["low", "medium", "high", "xhigh"] },
            "reasoningEfforts": { "type": "string", "pattern": "^(low|medium|high|xhigh)(,(low|medium|high|xhigh))*$" },
            "stream": { "type": "boolean" }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "model": { "minLength": 1, "pattern": ".*\\S.*" }
                },
                "required": ["model"]
              },
              "then": {
                "properties": {
                  "baseUrl": { "pattern": "^https?://\\S+$" }
                },
                "required": ["baseUrl"]
              }
            },
            {
              "if": {
                "properties": {
                  "baseUrl": { "minLength": 1, "pattern": ".*\\S.*" }
                },
                "required": ["baseUrl"]
              },
              "then": {
                "properties": {
                  "model": { "minLength": 1, "pattern": ".*\\S.*" }
                },
                "required": ["model"]
              }
            }
          ]
        },
        "rerank": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "model", "endpointOrder"],
          "properties": {
            "enabled": { "type": "boolean" },
            "baseUrl": {
              "type": "string",
              "description": "Empty falls back to the embedding URL (HttpReranker)."
            },
            "model": { "$ref": "#/definitions/nonPlaceholderString" },
            "endpointOrder": {
              "type": "string",
              "enum": ["score_first", "rerank_first"]
            }
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiKeySecretName"],
      "allOf": [{
        "if": {"required": ["apiKeySecretKey"], "properties": {"apiKeySecretKey": {"minLength": 1}}},
        "then": {"properties": {"apiKeySecretName": {"minLength": 1}}}
      }],
      "properties": {
        "apiKeySecretName": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "description": "Secret name only; values never carry key material (D7)."
        },
        "apiKeySecretKey": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9._-]*$",
          "description": "Optional shared Secret data-key name for all model legs, never the API key value."
        },
        "caConfigMapName": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "description": "Optional trust bundle ConfigMap; empty disables the mount."
        }
      }
    },
    "tracing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "endpoint": { "type": "string" },
        "deploymentEnvironment": { "type": "string" },
        "serviceName": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9._-]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": {
            "properties": {
              "endpoint": { "pattern": "^(https?://\\S+)?$" }
            }
          }
        }
      ]
    },
    "openobserve": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "credentialsSecretName": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "runAsId": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$" }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "collector": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": ["boolean", "null"] }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": ["boolean", "null"] }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "allowedNamespaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          }
        }
      },
      "if": {
        "properties": { "enabled": { "const": false } },
        "required": ["enabled"]
      },
      "then": {
        "properties": { "allowedNamespaces": { "maxItems": 0 } }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "timeoutSeconds"],
      "properties": {
        "enabled": { "type": "boolean" },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "destinationCA": {
          "type": "string",
          "description": "Namespace service-CA bundle (non-secret generated value, D8)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": {
            "properties": {
              "destinationCA": { "minLength": 1, "pattern": ".*\\S.*" }
            },
            "required": ["destinationCA"]
          }
        }
      ]
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "secretName": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "description": "Operator-created Secret holding data key service-token; never key material (D7). Required when enabled."
        },
        "storageSize": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$" },
        "retentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": {
            "properties": { "secretName": { "minLength": 1 } },
            "required": ["secretName"]
          }
        }
      ]
    },
    "openwebui": {
      "type": "object",
      "additionalProperties": false,
      "description": "Open WebUI docs front end (ADR-0007, #1074). Default on; the chart template fails closed with a fixed message while required site inputs are missing.",
      "properties": {
        "enabled": { "type": "boolean" },
        "secretName": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "description": "Operator-created Secret with webui-secret-key and oidc-client-secret (optional admin-api-key); never key material (D7)."
        },
        "host": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)+$",
          "description": "Route host; the OIDC redirect URI is https://<host>/oauth/oidc/callback."
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650,
          "description": "Chat retention window in days (maintainer decision 2026-10-24: 30), enforced by the purge sidecar. Required when enabled."
        },
        "storageSize": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$" },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "providerUrl": {
              "type": "string",
              "pattern": "^$|^https://[^\\s/]+(/\\S*)?/\\.well-known/openid-configuration$"
            },
            "clientId": { "type": "string", "maxLength": 255, "pattern": "^[^\\s,]*$" },
            "groupClaim": { "type": "string", "pattern": "^[A-Za-z0-9_:/.-]+$" },
            "rolesClaim": { "type": "string", "pattern": "^[A-Za-z0-9_:/.-]+$" },
            "allowedRoles": { "type": "string", "pattern": "^$|^[^,\\s]+(,[^,\\s]+)*$" },
            "adminRoles": { "type": "string", "pattern": "^$|^[^,\\s]+(,[^,\\s]+)*$" },
            "caBundle": {
              "type": "string",
              "pattern": "^$|^\\s*(-----BEGIN CERTIFICATE-----[A-Za-z0-9+/=\\s]+-----END CERTIFICATE-----\\s*)+$",
              "description": "Optional PEM certificates of the CA that issued the IdP's TLS certificate; added to the public trust stores, never replacing them."
            }
          }
        },
        "idpEgress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidrs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$"
              }
            },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": {
            "required": ["oidc", "idpEgress"],
            "properties": {
              "oidc": { "required": ["groupClaim", "rolesClaim"] },
              "idpEgress": { "required": ["port"] }
            }
          }
        }
      ]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["className"],
      "properties": {
        "className": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "__[A-Z0-9_]+__" },
          "description": "RWO block storage class; NFS refusal stays owned by shell preflight."
        }
      },
      "not": {
        "properties": {
          "className": { "pattern": "[Nn][Ff][Ss]" }
        }
      }
    },
    "ingest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "workers", "reingest", "collectionPolicy"],
      "if": {
        "properties": { "authorizeFromCatalog": { "const": true } },
        "required": ["authorizeFromCatalog"]
      },
      "then": {
        "required": ["retireDocs"],
        "properties": { "retireDocs": { "minItems": 1 } }
      },
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "True renders the explicit Job; steady-state releases use false (D3)."
        },
        "corpusPVC": {
          "type": "string",
          "description": "Caller-supplied corpus PVC; required when enabled."
        },
        "workSize": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$" },
        "workers": {
          "type": "integer",
          "minimum": 1
        },
        "peerUrls": {
          "type": "string",
          "description": "Comma-separated direct Qdrant REST endpoints. Empty is unconfigured; runtime placement checks refuse missing multi-peer evidence."
        },
        "reingest": { "type": "boolean" },
        "retireDocs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\"\\\\*?]+$",
            "not": { "pattern": "__[A-Z0-9_]+__" }
          },
          "description": "Malformed @-sides, control characters and backend inventory checks stay shell-owned (D6)."
        },
        "authorizeFromCatalog": {
          "type": "boolean",
          "description": "Renders --authorize-from-catalog; valid only with a non-empty retireDocs (issue #1005)."
        },
        "contextualEnabled": { "type": "boolean" },
        "contextLlmBaseUrl": { "type": "string" },
        "contextLlmModel": { "type": "string" },
        "collectionPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shardNumber", "replicationFactor", "writeConsistencyFactor"],
          "properties": {
            "shardNumber": { "type": "integer", "minimum": 1 },
            "replicationFactor": { "type": "integer", "minimum": 1 },
            "writeConsistencyFactor": { "type": "integer", "minimum": 1 }
          },
          "description": "W<=RF validation stays owned by validate_collection_policy in shell (D6)."
        },
        "resources": {
          "type": "object",
          "description": "Kubernetes resource requests/limits for the ingest container."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": {
            "properties": {
              "corpusPVC": { "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$" }
            },
            "required": ["corpusPVC"]
          }
        }
      ]
    },
    "pullSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent"],
      "properties": {
        "agent": {
          "type": "object",
          "description": "Kubernetes resource requests/limits for the agent container."
        },
        "feedback": {
          "type": "object",
          "description": "Kubernetes resource requests/limits for the feedback service container."
        },
        "openwebui": {
          "type": "object",
          "description": "Kubernetes resource requests/limits for the Open WebUI container."
        }
      }
    }
  }
}
