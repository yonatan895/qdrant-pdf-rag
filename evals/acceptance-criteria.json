          "scope": "answer",
          "op": ">=",
          "threshold": 0.8333,
          "statistic": "point",
          "min_n": 24,
          "rationale": "#447 G2 proposed bar: 20 of 24 useful, supported, source-traceable answers over ALL requests (length/transport failures and false refusals count against it)"
