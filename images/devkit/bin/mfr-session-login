#!/usr/bin/env python3
"""Write the bastion session credentials into the memory-only session directory.

Token mode (default): stdin is the operator's `oc whoami -t` output; writes a
kubeconfig targeting kubernetes.default.svc and an env file to source.
--registry: stdin is the registry robot Secret's .dockerconfigjson (raw JSON or
base64); writes auth.json. Messages are fixed and never include input bytes.
Exit codes: 0 ok, 2 refused input or environment.
"""

import base64
import binascii
import contextlib
import json
import os
import re
import shlex
import stat
import sys

DEFAULT_DIR = "/run/mfr-session"
PRIVATE = "private"
DEFAULT_CA = "/etc/mfr/kube-root-ca/ca.crt"
SERVER = "https://kubernetes.default.svc"
MAX_INPUT = 16 * 1024
MEMORY_FS = {"tmpfs", "ramfs"}
TOKEN_RE = re.compile(r"[A-Za-z0-9._~+/=-]+")
LABEL_RE = re.compile(r"[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?")


class Refused(Exception):
    pass


def refuse(message: str) -> Refused:
    return Refused(message)


def _unescape_mount(path: str) -> str:
    return re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), path)


def _fstype_of(path: str) -> str | None:
    best_len, best = -1, None
    try:
        with open("/proc/self/mountinfo", encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError:
        return None
    for line in lines:
        left, sep, right = line.partition(" - ")
        fields = left.split()
        if not sep or len(fields) < 5:
            continue
        mount = _unescape_mount(fields[4])
        inside = path == mount or path.startswith(mount.rstrip("/") + "/")
        if inside and len(mount) > best_len:
            best_len, best = len(mount), right.split()[0]
    return best


def session_dir() -> str:
    """Return the helper-owned private directory under the memory mount root."""
    root = os.environ.get("MFR_SESSION_DIR") or DEFAULT_DIR
    try:
        st = os.lstat(root)
    except OSError:
        raise refuse(
            "mfr-session: the session mount is missing; mount a memory emptyDir at /run/mfr-session"
        ) from None
    if not stat.S_ISDIR(st.st_mode):
        raise refuse("mfr-session: the session mount must be a directory, not a link")
    if _fstype_of(os.path.realpath(root)) not in MEMORY_FS:
        raise refuse("mfr-session: the session mount must be on a memory filesystem (tmpfs)")
    private = os.path.join(root, PRIVATE)
    bad = refuse(
        "mfr-session: the private session directory must be a real directory "
        "owned by this user with mode 0700; run mfr-session-logout and retry"
    )
    created = False
    try:
        os.mkdir(private, 0o700)
        created = True
    except FileExistsError:
        pass
    except OSError:
        raise refuse("mfr-session: could not create the private session directory") from None
    try:
        pst = os.lstat(private)
        if created:
            # mkdir inherits a setgid parent's bit; chmod clears it.
            os.chmod(private, 0o700)
            pst = os.lstat(private)
    except OSError:
        raise bad from None
    if (
        not stat.S_ISDIR(pst.st_mode)
        or pst.st_uid != os.getuid()
        or stat.S_IMODE(pst.st_mode) != 0o700
        or pst.st_mode & (stat.S_ISGID | stat.S_ISUID | stat.S_ISVTX)
    ):
        raise bad
    return private


def read_stdin() -> str:
    data = sys.stdin.buffer.read(MAX_INPUT + 1)
    if len(data) > MAX_INPUT:
        raise refuse("mfr-session: input is too large; pipe only the credential")
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        raise refuse("mfr-session: input is not valid UTF-8 text") from None
    text = text.removeprefix("\ufeff")
    return text.rstrip("\r\n")


def write_atomic(directory: str, name: str, content: str) -> None:
    tmp = os.path.join(directory, f".{name}.tmp.{os.getpid()}")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())
        os.rename(tmp, os.path.join(directory, name))
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def login_token(directory: str) -> None:
    namespace = os.environ.get("MFR_NAMESPACE", "")
    if not LABEL_RE.fullmatch(namespace):
        raise refuse("mfr-session: MFR_NAMESPACE must be set to the namespace (a DNS-1123 label)")
    ca = os.environ.get("MFR_KUBE_CA") or DEFAULT_CA
    try:
        with open(ca, encoding="ascii") as f:
            ca_ok = "-----BEGIN CERTIFICATE-----" in f.read(1 << 20)
    except OSError, UnicodeDecodeError:
        ca_ok = False
    if not ca_ok:
        raise refuse(
            "mfr-session: the cluster CA file is missing or not a PEM certificate; "
            "mount the kube-root-ca.crt ConfigMap or set MFR_KUBE_CA"
        )
    token = read_stdin()
    if not TOKEN_RE.fullmatch(token):
        raise refuse(
            "mfr-session: input is not a single-line token; run "
            "`oc whoami -t | oc exec -i <bastion> -- mfr-session-login`"
        )
    kubeconfig = {
        "apiVersion": "v1",
        "kind": "Config",
        "clusters": [
            {
                "name": "cluster",
                "cluster": {"server": SERVER, "certificate-authority": os.path.abspath(ca)},
            }
        ],
        "users": [{"name": "operator", "user": {"token": token}}],
        "contexts": [
            {
                "name": "session",
                "context": {"cluster": "cluster", "user": "operator", "namespace": namespace},
            }
        ],
        "current-context": "session",
    }
    kc_path = os.path.join(directory, "kubeconfig")
    auth_path = os.path.join(directory, "auth.json")
    write_atomic(directory, "kubeconfig", json.dumps(kubeconfig, indent=2) + "\n")
    write_atomic(
        directory,
        "env",
        f"export KUBECONFIG={shlex.quote(kc_path)}\n"
        f"export REGISTRY_AUTH_FILE={shlex.quote(auth_path)}\n",
    )
    print("mfr-session: kubeconfig written; source the env file to use it")


def login_registry(directory: str) -> None:
    text = read_stdin().strip()
    bad = refuse(
        "mfr-session: input is not a .dockerconfigjson (raw JSON or base64) with an auths entry"
    )
    if not text.startswith("{"):
        try:
            text = base64.b64decode(text, validate=True).decode("utf-8")
        except binascii.Error, ValueError:
            raise bad from None
    try:
        doc = json.loads(text)
    except ValueError:
        raise bad from None
    auths = doc.get("auths") if isinstance(doc, dict) else None
    if (
        not isinstance(auths, dict)
        or not auths
        or not all(isinstance(k, str) and k and isinstance(v, dict) for k, v in auths.items())
    ):
        raise bad
    write_atomic(directory, "auth.json", json.dumps(doc) + "\n")
    print("mfr-session: registry auth written")


def main(argv: list[str]) -> int:
    if argv not in ([], ["--registry"]):
        print("mfr-session: usage: mfr-session-login [--registry]", file=sys.stderr)
        return 2
    try:
        directory = session_dir()
        if argv:
            login_registry(directory)
        else:
            login_token(directory)
    except Refused as e:
        print(e, file=sys.stderr)
        return 2
    except OSError:
        print(
            "mfr-session: could not write the session files; check the session directory",
            file=sys.stderr,
        )
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
