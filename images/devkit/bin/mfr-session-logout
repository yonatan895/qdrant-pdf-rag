#!/usr/bin/env python3
"""End the bastion session: revoke the OAuth token, then remove session files.

Idempotent. Exit codes: 0 ok, 1 logout incomplete (token may not be revoked).
Messages are fixed and never include credential bytes or command output.
"""

import os
import subprocess
import sys

DEFAULT_DIR = "/run/mfr-session"
FILES = ("kubeconfig", "auth.json", "env")


def main() -> int:
    directory = os.environ.get("MFR_SESSION_DIR") or DEFAULT_DIR
    kubeconfig = os.path.join(directory, "kubeconfig")
    revoked = True
    if os.path.lexists(kubeconfig):
        try:
            revoked = (
                subprocess.run(
                    ["oc", "logout", "--kubeconfig", kubeconfig],
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=60,
                    check=False,
                ).returncode
                == 0
            )
        except OSError, subprocess.SubprocessError:
            revoked = False
    leftover = False
    for name in FILES:
        try:
            os.unlink(os.path.join(directory, name))
        except FileNotFoundError:
            pass
        except OSError:
            leftover = True
    if leftover:
        print(
            "mfr-session: could not remove all session files; delete the bastion pod",
            file=sys.stderr,
        )
        return 1
    if not revoked:
        print(
            "mfr-session: the session files were removed but the token may not be revoked; "
            "run `oc logout` on the Windows workstation",
            file=sys.stderr,
        )
        return 1
    print("mfr-session: session ended")
    return 0


if __name__ == "__main__":
    sys.exit(main())
