{
  "autoupdate": false,
  "share": "disabled",
  "enabled_providers": ["site-litellm"],
  "model": "site-litellm/{env:MFR_LLM_MODEL}",
  "small_model": "site-litellm/{env:MFR_LLM_MODEL}",
  "provider": {
    "site-litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Site LiteLLM (dev key mfr-dev-litellm)",
      "options": {
        "baseURL": "{env:MFR_LLM_BASE_URL}",
        "apiKey": "{file:/run/secrets/mfr-dev-litellm}",
        "timeout": 30000,
        "headerTimeout": 30000,
        "chunkTimeout": 30000
      },
      "models": {
        "{env:MFR_LLM_MODEL}": {
          "name": "{env:MFR_LLM_MODEL}",
          "tool_call": true,
          "limit": { "context": 32000, "output": 12000 }
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "lsp": "deny",
    "external_directory": "ask",
    "doom_loop": "ask",
    "shell": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "sed -n *": "allow",
      "python3 -m pytest *": "allow",
      "pytest *": "allow",
      "ruff *": "allow",
      "mypy *": "allow",
      "sh scripts/tools/run-task.sh *": "allow",
      "git push*": "deny",
      "git remote*": "deny",
      "git config*": "deny",
      "curl*": "deny",
      "wget*": "deny",
      "ssh*": "deny",
      "scp*": "deny",
      "oc *": "deny",
      "kubectl*": "deny",
      "helm *": "deny",
      "podman*": "deny",
      "docker*": "deny",
      "skopeo*": "deny",
      "pip *": "deny",
      "python3 -m pip*": "deny"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "sed -n *": "allow",
      "python3 -m pytest *": "allow",
      "pytest *": "allow",
      "ruff *": "allow",
      "mypy *": "allow",
      "sh scripts/tools/run-task.sh *": "allow",
      "git push*": "deny",
      "git remote*": "deny",
      "git config*": "deny",
      "curl*": "deny",
      "wget*": "deny",
      "ssh*": "deny",
      "scp*": "deny",
      "oc *": "deny",
      "kubectl*": "deny",
      "helm *": "deny",
      "podman*": "deny",
      "docker*": "deny",
      "skopeo*": "deny",
      "pip *": "deny",
      "python3 -m pip*": "deny"
    }
  }
}
