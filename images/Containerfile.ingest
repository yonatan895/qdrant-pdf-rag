# Ingest image: UBI, non-root, wheelhouse + BM25 weights baked in.
# Build on the connected host (sh scripts/tools/run-task.sh artifacts:images); BM25 weights must never be
# downloaded at runtime (air-gap rule, architecture.md section 3.1).
# Python 3.14 GIL (issue #5): ubi9/python-314-minimal ships python3.14 + pip;
# no microdnf python install needed. Exact image pinned in images.txt
# (digest-only form: tag+digest combined is not a valid reference; tag here
# was 9.8, digest is the contract).
FROM registry.access.redhat.com/ubi9/python-314-minimal@sha256:1e4b43488508216fee35b87e6b5425f4ef475eacf9c113f5b901e27af3844fba

# Wheels: built on the connected host (sh scripts/tools/run-task.sh artifacts:wheelhouse), installed offline.
# Named build contexts (see task artifacts:images): wheelhouse=, bm25=
USER root
COPY requirements.lock.txt /opt/rag-locks/requirements.lock.txt
COPY locks/cp314-linux-x86_64.json /opt/rag-locks/locks/cp314-linux-x86_64.json
COPY scripts/dependency_lock.py /opt/rag-tools/dependency_lock.py
COPY --from=wheelhouse / /wheelhouse/
RUN python3 /opt/rag-tools/dependency_lock.py --root /opt/rag-locks wheelhouse --profile runtime --directory /wheelhouse \
    && PIP_CONFIG_FILE=/dev/null python3 -m pip --isolated install --no-index --no-cache-dir --only-binary=:all: --require-hashes --find-links /wheelhouse -r /opt/rag-locks/requirements.lock.txt \
    && python3 -m pip check \
    && python3 /opt/rag-tools/dependency_lock.py --root /opt/rag-locks installed --profile runtime --image --output /opt/rag-locks/installed-inventory.json \
    && rm -rf /root/.cache

# BM25 sparse weights (FastEmbed Qdrant/bm25) — no network at run time.
COPY --from=bm25 / /opt/bm25/

COPY src/ /app/src/
# Demo PDF generator for the connected CI E2E (issue #8); harmless in prod.
COPY scripts/ /app/scripts/
ENV PYTHONPATH=/app/src \
    BM25_CACHE_DIR=/opt/bm25 \
    HF_HOME=/opt/bm25/hf

# The python-314-minimal base defaults to a non-root user; setup needs root.
USER root
RUN useradd -u 1000 -M -s /sbin/nologin rag \
    && mkdir -p /work \
    && chown -R rag:0 /work /opt/bm25 \
    && chmod -R g=u /work /opt/bm25
USER 1000
WORKDIR /work

ENTRYPOINT ["python3", "-m", "mainframe_rag.ingest.run_ingest"]
