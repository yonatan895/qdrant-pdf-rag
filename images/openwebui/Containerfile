# Open WebUI product image (issues #1073, #1074; ADR-0007 R1, ADR-0008): the
# unmodified upstream Open WebUI v0.13.4 SLIM release, derived only to run as
# an arbitrary non-root UID in group 0 (OpenShift restricted-v2, no anyuid).
#
# Derived, not rebuilt: no source checkout, no Node/SvelteKit build, no pip
# install, no COPY. The only layer added below changes file ownership and mode
# bits, the same operation as upstream's USE_PERMISSION_HARDENING build argument
# (chgrp 0, group permissions = owner permissions, setgid directories); the
# upstream bytes and the "Open WebUI" branding are unchanged (LICENSE clause 4,
# docs/licensing.md). It lives in images/openwebui/ (not images/Containerfile.*)
# because its base is the upstream image, not the UBI Python base that
# scripts/image_inventory.py --check-containerfiles pins for the app images; a
# test pins this FROM digest to the ghcr.io/open-webui line of images.txt.
# Build on the connected host only, never in the air gap; no build contexts:
#   docker build -f images/openwebui/Containerfile \
#     -t ghcr.io/<owner>/qdrant-pdf-rag-openwebui:v0.13.4-slim images/openwebui
# The pushed manifest digest is then recorded in images.txt (the pin).
#
# Base: ghcr.io/open-webui/open-webui:v0.13.4-slim, image index digest below
# (amd64 manifest sha256:4da3e2b46ebb1dd63f025ec1cf20a0d834094d75bd2a390762810adc76dbc641;
# org.opencontainers.image.revision 0666e59d26a4d056e0bacee41742486badd71cf8 =
# upstream tag v0.13.4; created 2026-11-17; #1357 import). Tag plus digest is not a valid
# reference here, so the digest is the contract (as in Containerfile.agent).
# The slim variant matters: it builds no vector client at import time and
# ships no embedding, reranker or Whisper models (no second vector store).
FROM ghcr.io/open-webui/open-webui@sha256:0c4439e78c24c85e3e7a41936771d3b02f0df38daf28a086cd83ca74804f7676

USER 0:0
# Writable paths at run time, each covered here and by a mount in the trial:
#   /app/backend/data             DATA_DIR (SQLite, uploads, cache): the PVC
#   /app/backend/open_webui/static STATIC_DIR, refilled from /app/build/static at startup
#   /root                         HOME caches
#   /tmp                          scratch
# With a read-only root filesystem the trial mounts an emptyDir over static,
# /root and /tmp; the group-0 bits below make the same paths work without one.
RUN set -eux; \
    mkdir -p /app/backend/data /app/backend/open_webui/static /root/.cache; \
    chgrp -R 0 /app /root; \
    chmod -R g=u /app /root; \
    find /app /root -type d -exec chmod g+s {} +; \
    chmod 1777 /tmp

# Any UID works; restricted-v2 assigns one from the namespace range in group 0.
USER 1000:0
WORKDIR /app/backend
EXPOSE 8080
CMD ["bash", "start.sh"]
