# Site inputs for the gap orchestration VM (#1172; docs/agents-vm.md#site-inputs).
#
# Copy to /etc/mfr-agents/site.env (root:agents, 0640) and fill in the site values.
# The real file stays outside git: scripts/devkit/agents_vm.py refuses a site env file
# inside a git work tree. Every address below is a documentation-only example (RFC 5737
# TEST-NET); none is a site address. Values are literal KEY=value lines, never run by a
# shell. The fence filters by IP, so each address list holds IP addresses or CIDRs that
# the site keeps stable (resolve the names at install time and re-render on a change).

# The dedicated unprivileged user that runs herdr-core, OpenCode and Podman.
MFR_VM_AGENTS_USER=agents

# Allowed egress: DNS resolvers (UDP and TCP 53), GitLab (HTTPS and SSH), LiteLLM (HTTPS).
MFR_VM_DNS=192.0.2.53
MFR_VM_GITLAB=192.0.2.10
MFR_VM_GITLAB_PORTS=443 22
MFR_VM_GITLAB_HOST=gitlab.site.example
MFR_VM_LITELLM=192.0.2.20
MFR_VM_LITELLM_PORTS=443

# OpenCode's provider: the site LiteLLM and the model the site config names.
MFR_VM_LITELLM_BASE_URL=https://litellm.site.example/v1
MFR_VM_LLM_MODEL=site-reasoning-model

# Negative controls for the egress proof, label=address:port. All six labels are
# required, and none may fall inside an allowed address: production Qdrant, the agent,
# the OpenShift API, an internet address, and the VM itself (a service on its loopback
# and one on its own address; pasta lets containers reach both as the agents user)
# must all be refused by the fence. Pick targets that answer with the fence off (sshd on
# port 22 does), or the fence-off negative control proves nothing.
MFR_VM_BLOCKED=qdrant=198.51.100.10:6333 agent=198.51.100.11:8000 openshift-api=198.51.100.12:6443 internet=203.0.113.80:443 host-loopback=127.0.0.1:22 host-address=192.0.2.30:22

# Optional: the viewers' SSH client addresses, let in by the systemd layer (the
# nftables layer still refuses agents-owned connections to them).
MFR_VM_SSH_CLIENTS=

# The kit image as loaded into the agents user's Podman storage, and its pinned digest
# (scripts/tools/devkit-pin.txt at the release commit).
MFR_VM_KIT_IMAGE=localhost/qdrant-pdf-rag-devkit:<kit key>
MFR_VM_KIT_DIGEST=sha256:<64 hex from devkit-pin.txt>

# The agents' work directory (git clones and worktrees), mounted at /work.
MFR_VM_WORK=/home/agents/work
# SELinux label of that bind mount: Z (private relabel, the default for an enforcing
# RHEL-family VM), z (shared with other containers) or none. Never :U (it chowns the tree).
MFR_VM_VOLUME_LABEL=Z

# The agents' own tools (pytest, task) on top of the agent overhead limits of 4 CPU and
# 4 GiB. Requests stay at 2 CPU and 2 GiB.
MFR_VM_TOOL_CPUS=2
MFR_VM_TOOL_MEMORY_MIB=4096
