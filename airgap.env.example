# airgap.env.example
#
# Copy to airgap.env on the connected host and fill in. NEVER commit airgap.env.
# scripts/airgap/*.sh source this file (Task airgap:*) and fail closed on
# missing required keys, EMBED_MODE=hash, or NFS-looking storage classes.
# Values here are placeholders only: no real registries, namespaces, or URLs.
#
# Explicit selection (issue #478): AIRGAP_ENV=/path/to/poc.env sh scripts/airgap/validate.sh
# selects that file instead of ./airgap.env. The selected path must be a readable
# regular file (relative paths resolve from the repository root) or the launcher
# exits nonzero before any registry/cluster mutation:
#   FAIL: AIRGAP_ENV selects '/path/to/poc.env' but it is not a readable regular file ...
# Remediation: fix the path (typo?) or unset AIRGAP_ENV to use ./airgap.env / environment-only.

# --- Internal registry (push from air-gap, pulled in-cluster) ---
INTERNAL_REGISTRY=registry.example.internal/mainframe-rag
# Optional skopeo flags for private registries (e.g. self-signed TLS certs or custom auth)
# SKOPEO_ARGS=--dest-tls-verify=false
# INSECURE_REGISTRY=false            # true => --src-tls-verify=false on pack, --dest-tls-verify=false on load

# Image roles under INTERNAL_REGISTRY (issue #808; docs/deploy.md#quay-image-roles).
# load.sh writes exactly these paths from the signed bundle; the GitLab pipeline
# never builds or pushes an application image:
#   qdrant-pdf-rag-agent:<IMAGE_SHA>   qdrant-pdf-rag-ingest:<IMAGE_SHA>
#   qdrant/qdrant:v1.19.2-unprivileged jaegertracing/jaeger:v2.20.0
#   openshift4/ose-oauth-proxy:v4.14   (only when the OAuth sidecar is packed)
# CI job and service images are a separate role. They are read by .gitlab-ci.yml
# from protected GitLab CI/CD variables, not from this file; the names are:
#   CI_APPROVED_REGISTRY=registry.example.internal/ci-tools   # required, no default
#   CI_PYTHON_IMAGE=                                           # optional complete reference
# Release pipelines run from a protected tag; unprotected tags fail hygiene.

# --- Target namespace / cluster ---
NAMESPACE=mainframe-rag
QDRANT_RELEASE=qdrant                # helm release + service name + apikey secret prefix
STORAGE_CLASS=                       # REQUIRED: RWO block; NFS is refused
SNAPSHOT_STORAGE_CLASS=              # optional; falls back to STORAGE_CLASS (both are NFS-refused)
PULL_SECRET=                         # optional secret name if the namespace cannot pull anonymously

# OpenShift restricted-v2 assigns the namespace UID/group. Keep the overlay's
# runAsUser/runAsGroup/fsGroup unset; do not grant anyuid. Kind has no SCC and
# uses an explicit local fsGroup override (see docs/local-kind.md).
# QDRANT_EXTRA_VALUES=qdrant-scc.yaml   # extra Helm -f file (rehearsal sizing/SCC only; never prod values)
# QDRANT_STORAGE_SIZE=                  # shrink data/snapshot PVCs for rehearsal (empty = 500Gi prod values)

# --- Images (pack side pins these; see images.txt for the Qdrant pin) ---
IMAGE_SHA=                           # default: git rev-parse HEAD on the pack side
QDRANT_IMAGE=docker.io/qdrant/qdrant:v1.19.2-unprivileged
# QDRANT_TAG=                        # override the chart image tag (rehearsal only; empty = derived from QDRANT_IMAGE)
# Operator-console runtime deps (jinja2, python-multipart) live in
# requirements.lock.txt: a lockfile bump needs `sh scripts/tools/run-task.sh artifacts:wheelhouse artifacts:bm25`,
# a connected image rebuild/push, and a fresh pack before the air-gap install sees them.

# --- Platform inference through LiteLLM (this repo does not host models) ---
GATEWAY_BASE_URL=                    # shared API base, e.g. https://sample-api/v1 (example URL only)
EMBED_BASE_URL=                      # explicit override; otherwise GATEWAY_BASE_URL
EMBED_MODEL=embedding-v1             # example platform alias; configure the deployed embedding alias
DENSE_DIM=4096                       # REQUIRED: must match the embedding model output (4096 = Qwen3-Embedding-8B)
EMBED_MODEL_REVISION=                # REQUIRED: immutable model/config revision; aliases are mutable
LLM_BASE_URL=                        # explicit override; otherwise GATEWAY_BASE_URL
LLM_MODEL_REASONING=code             # example reasoning alias; empty keeps answers disabled
#GATEWAY_PROBE_MAX_TOKENS=16          # readiness only; decimal 1–4096; Colab lab explicitly uses 512

# Optional application budgets (#706); unset keeps the application defaults
# shown (#777, sized for Qwen3.8-27B; the 8192 thinking reserve was priced for
# xhigh and is unchanged by #917). LLM_MAX_MODEL_LEN must not exceed the served model window (--max-model-len of the reasoning server).
# LLM_MAX_MODEL_LEN=32768                    # 512..131072
# LLM_RESERVED_OUTPUT_TOKENS=2560            # 128..16384
# LLM_THINKING_RESERVE_TOKENS_SIMPLE=8192    # 0..16384; explicit zero is retained
# LLM_THINKING_RESERVE_TOKENS_COMPLEX=8192   # 0..16384
# LLM_REASONING_EFFORT_SIMPLE=medium        # low/medium/high/xhigh (#917)
# LLM_REASONING_EFFORT_COMPLEX=medium       # must be listed in LLM_REASONING_EFFORTS
# LLM_REASONING_EFFORTS=low,medium,xhigh    # served template's efforts; Qwen3.8 (#748)
# LLM_STREAM=true                          # strict true/1/yes or false/0/no

# Request bounds (#374). Empty keeps the chart: deadline 270 s, no admission limit.
# Leave admission unset until the measured stepped run approves values (#843 D4).
# REQUEST_DEADLINE_S=270                   # 0..3600; nonzero must be < 300 (route timeout); 0 disables
# REQUEST_MAX_CONCURRENT=                  # 0..1000 per agent replica; 0 = unlimited
# REQUEST_QUEUE_MAX=                       # 0..1000 waiting requests
# REQUEST_QUEUE_WAIT_S=                    # 0..300 seconds a queued request may wait

# --- Optional cross-encoder reranker (issue #76, default off) ---
# RERANK_ENABLED=false
# RERANK_BASE_URL=                   # shared gateway, then existing EMBED_BASE_URL fallback
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_ENDPOINT_ORDER=score_first  # gateway native leg first: rerank_first (see probe_gateway.py)

# --- Gateway API key (LiteLLM, all model legs) ---
# Key material NEVER lives in this file. Use an operator-created Secret and
# select its shared data-key name; every agent/ingest model leg references it.
# Example (credential file supplied through the platform process):
#   kubectl -n mainframe-rag create secret generic gateway-api-keys \
#     --from-file=api-key=/secure/gateway/api-key
#GATEWAY_API_KEY_SECRET=gateway-api-keys
#GATEWAY_API_KEY_SECRET_KEY=api-key   # data-key NAME, never the API key value
# Leaving SECRET_KEY empty retains the legacy llm-api-key/embed-api-key/
# rerank-api-key/context-llm-api-key entries in the same Secret. An unset
# Secret name remains keyless; a shared key name requires a Secret name.
# Rotate the Secret, then restart the agent or start a new ingest Job.
# Local tools can still use their per-operation *_API_KEY process variables.

# --- Optional ingest: contextual retrieval prefixes (issue #78, default off) ---
# Enabling changes every dense vector: recreate the collection on first use.
#CONTEXTUAL_EMBED_ENABLED=false
#CONTEXT_LLM_BASE_URL=               # override; otherwise GATEWAY_BASE_URL (per-chunk gists)
#CONTEXT_LLM_MODEL=

# --- Tracing (issue #83, ON by default) ---
# Unset deploys Jaeger v2 and wires tracing into the agent and the ingest Job
# (the in-cluster default below). Set a custom OTLP/HTTP collector origin if
# the platform provides one, or off/none/false/0 to disable tracing and skip
# the Jaeger deployment.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
#OTEL_EXPORTER_OTLP_ENDPOINT=off
# Decouple the bundled Jaeger backend from trace export (issue #529 OBS-2):
# unset follows tracing (off above skips Jaeger too); false exports to an
# external collector without the bundled backend; true while tracing is off
# is rejected. Explicit values must be true/false. JAEGER_ENABLED=false must be
# paired with an intentional destination (issue #568): an explicit collector
# URL (the former http://jaeger:4318 is fine if a platform-owned service lives
# there) or off. Alone it is refused. A configured collector is not proof that
# traces arrive; airgap:smoke reports that as NOT VERIFIED.
#JAEGER_ENABLED=false
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.platform:4318
# Deploy identity on every span (service.version is IMAGE_SHA for the agent;
# the ingest Job carries no IMAGE_SHA yet, issue #315. deployment.environment
# is omitted when unset; service.name defaults per process —
# mainframe-rag-agent / mainframe-rag-ingest when unset):
OTEL_DEPLOYMENT_ENVIRONMENT=prod
#OTEL_SERVICE_NAME=my-rag-prod
# Jaeger query API used by `sh scripts/tools/run-task.sh airgap:smoke` to prove a span landed; only
# change it when a custom collector exposes a Jaeger-compatible query API.
#JAEGER_QUERY_URL=http://jaeger:16686

# Optional chat follow-up rewriting through the designated reasoning model.
# Default remains off; enabling adds one bounded call for follow-up retrieval.
# CHAT_CONDENSE_ENABLED=false

# --- Optional metrics (issue #187, default off) ---
# true => serve Prometheus exposition on GET /metrics and deploy the
# ServiceMonitor for user-workload-monitoring scrapes. Cluster prerequisite
# (cluster-admin): UWM enabled and the namespace labeled for UWM discovery.
# METRICS_ENABLED=true
# Decouple the ServiceMonitor from exposition (issue #529 OBS-2): unset
# follows METRICS_ENABLED; false serves /metrics without the monitor (e.g.
# platform-UWM scrape modes); true while METRICS_ENABLED is not true is
# rejected. Explicit values must be true/false.
#SERVICEMONITOR_ENABLED=false

# --- Operator console selection (issue #479, default on) ---
# UI_ENABLED=false renders the API-only POC profile: the application serves
# its stable disabled contract for console form/stream/history/static entry
# points. Unset/true keeps /ui served. Independent of AGENT_ROUTE below:
# disabling the UI never removes OAuth/TLS/access controls, and Route-off
# is not a UI-off claim.
# UI_ENABLED=false

# --- Agent ingress NetworkPolicy (issue #373, default ON) ---
# The chart renders NetworkPolicy/rag-agent-ingress: the agent's unauthenticated
# HTTP port 8080 is reachable only from this namespace, from the monitoring
# namespaces when METRICS_ENABLED=true, and from the namespaces listed below;
# the OAuth port 8443 (AGENT_ROUTE=true) is reachable from the OpenShift router.
# Ingress only, agent pods only. A pod in ANOTHER namespace that calls
# rag-agent:8080 (for example an MCP server) is denied unless its namespace is
# listed. Enforcement and coexistence with site policies are site acceptance.
# AGENT_NETWORK_POLICY=false renders no policy (the allow-list must then be empty).
# AGENT_NETWORK_POLICY=true
# Comma-separated namespace names (DNS-1123 labels, no spaces) allowed to reach 8080.
# AGENT_NETWORK_POLICY_ALLOWED_NAMESPACES=

# --- Answer-feedback service (issue #804, ADR-0005, default OFF) ---
# FEEDBACK_ENABLED=true deploys one rag-feedback pod (StatefulSet, the agent
# image) with a kept RWO claim rag-feedback-data, reachable only from agent pods
# (NetworkPolicy rag-feedback-ingress), and wires the agent to it. It stores
# question and answer text, so it needs AGENT_NETWORK_POLICY=true (the default;
# the deploy refuses it otherwise). The service purges expired records itself.
# FEEDBACK_SECRET names an operator-created Secret with data key `service-token`
# (the bearer token for both sides); never put the token in this file:
#   oc -n mainframe-rag create secret generic fb-secret --from-literal=service-token="$(openssl rand -hex 32)"
# Disabling removes the workload but KEEPS the claim and its content; nothing
# purges while it is off until you delete the claim (docs/deploy.md).
# FEEDBACK_ENABLED=false
# FEEDBACK_SECRET=
# FEEDBACK_STORAGE_SIZE=10Gi          # RWO claim on STORAGE_CLASS (Mi/Gi/Ti; unmeasured default)
# FEEDBACK_RETENTION_DAYS=180         # 1..3650; ADR-0005 default

# --- Prod agent extras ---
AGENT_ROUTE=false                    # true => reencrypt Route to the agent console via the oauth-proxy sidecar
                                     #        (default: ClusterIP only; /ui is still served in-cluster).
                                     #        Requires, in order: (1) the oauth-proxy digest recorded in
                                     #        images.txt plus a fresh `sh scripts/tools/run-task.sh airgap:pack` (pack skips the sidecar
                                     #        while sha256:PENDING); (2) Secret rag-agent-oauth-cookie:
                                     #          kubectl -n mainframe-rag create secret generic rag-agent-oauth-cookie \
                                     #            --from-literal=cookie-secret="$(openssl rand -base64 32 | head -c 32)"
                                     #        Deploy fails closed when either is missing (see install_and_ops §4.4.2).

# --- Optional ingest (sh scripts/tools/run-task.sh airgap:ingest) ---
CORPUS_PVC=                          # REQUIRED for ingest: caller-supplied PVC, mounted read-only
INGEST_WORKERS=4                     # CPU workers for parallel PDF ingest (default: 4)
INGEST_TIMEOUT=3600                  # seconds to wait for the ingest Job
# INGEST_WORK_SIZE=100Gi              # ingest-work scratch PVC (empty = 100Gi prod default; shrink for rehearsal)
# Maintenance modes (issue #391). One authorized publisher per shared
# ingest-work PVC/progress path; the launcher names a single Job and refuses
# malformed or unsupported combinations. Aliases/defaults are never flipped.
# INGEST_REINGEST=true               # forced rebuild/repair (renders --reingest)
# INGEST_RETIRE_DOCS=SA22-0000-00,SA22-7777-01@SOURCE_REV   # explicit approved removals (comma- or newline-separated; interior spaces preserved)
# QDRANT_URL / QDRANT_API_KEY: derived or chart-created; never in this file.

# --- Collection distribution policy (issue #360) ---
# Shard count / replication / write-consistency for the corpus collection and
# its paired completion/control collection. Production target topology:
# 6 logical shards, 3 copies each across the three Qdrant peers, 2 required
# write acknowledgements (one peer may be lost without blocking writes).
# The checked-in preset scripts/airgap/collection-policy.env supplies
# 6/3/2 when this file leaves the keys unset; values set here win, and an
# explicit caller environment wins over this file. The air-gap path merges
# the three sources and refuses an incomplete/impossible *effective* tuple
# before rendering (all three keys present, positive, W must be <= RF); a
# partial override inherits the remaining preset values.
# One-node / local / CI lanes must select 1/1/1 explicitly — a deliberate
# non-HA profile, never inferred from the available node count. Self-hosted
# Qdrant cannot reshard: the shard count is fixed at creation, and
# replicating an existing collection is a snapshot-gated migration, never
# automatic recreation. See docs/deploy.md#collection-policy.
QDRANT_SHARD_NUMBER=6
QDRANT_REPLICATION_FACTOR=3
QDRANT_WRITE_CONSISTENCY_FACTOR=2
# Explicit direct per-pod REST endpoints for alias-publication placement checks.
# Supply non-secret addresses reachable from the ingest Job; never use a balanced Service.
# No peers are inferred. Missing/duplicate/unreachable peers cannot certify RF3.
QDRANT_PEER_URLS=
# Example only (adapt release, headless service and namespace to your installation):
# QDRANT_PEER_URLS=http://qdrant-0.qdrant-headless:6333,http://qdrant-1.qdrant-headless:6333,http://qdrant-2.qdrant-headless:6333

# --- Forbid list (scripts refuse these) ---
# EMBED_MODE=hash is CI/dev only: pack/load/deploy/ingest all refuse it.
# LLM_API_KEY / EMBED_API_KEY / RERANK_API_KEY / CONTEXT_LLM_API_KEY with a
# value are refused in this file: keys live only in the cluster Secret named
# by GATEWAY_API_KEY_SECRET (see above).

# Optional operator-created ConfigMap in NAMESPACE with key ca-bundle.crt.
# Supply a COMPLETE trust bundle (gateway CA plus all other required roots):
# SSL_CERT_FILE replaces the HTTP client's default bundle. Never disable TLS.
# GATEWAY_CA_CONFIGMAP=gateway-ca
