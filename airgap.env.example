# airgap.env.example
#
# Copy to airgap.env on the connected host and fill in. NEVER commit airgap.env.
# scripts/airgap/*.sh source this file (make airgap-*) and fail closed on
# missing required keys, EMBED_MODE=hash, or NFS-looking storage classes.
# Values here are placeholders only: no real registries, namespaces, or URLs.

# --- Internal registry (push from air-gap, pulled in-cluster) ---
INTERNAL_REGISTRY=registry.example.internal/mainframe-rag
# Legacy alias accepted by scripts if INTERNAL_REGISTRY is unset:
# REGISTRY_INTERNAL=...
# Optional skopeo flags for private registries (e.g. self-signed TLS certs or custom auth)
# SKOPEO_ARGS=--dest-tls-verify=false
# INSECURE_REGISTRY=false            # true => adds --dest-tls-verify=false to skopeo copy

# --- Target namespace / cluster ---
NAMESPACE=mainframe-rag              # legacy alias: OPENSHIFT_NAMESPACE
QDRANT_RELEASE=qdrant                # helm release + service name + apikey secret prefix
STORAGE_CLASS=                       # REQUIRED: RWO block; NFS is refused
SNAPSHOT_STORAGE_CLASS=              # optional; falls back to STORAGE_CLASS
PULL_SECRET=                         # optional secret name if the namespace cannot pull anonymously

# Note on OpenShift restricted-v2 SCC:
# Qdrant's Helm chart specifies runAsUser: 1000 in overlays/openshift/values.yaml.
# If your namespace enforces MustRunAsRange UID allocation, either grant anyuid
# SCC to the qdrant service account:
#   oc adm policy add-scc-to-user anyuid -z qdrant -n mainframe-rag
# Or provide a project-specific UID override via QDRANT_EXTRA_VALUES.
# QDRANT_EXTRA_VALUES=qdrant-scc.yaml   # extra Helm -f file (rehearsal sizing/SCC only; never prod values)
# QDRANT_STORAGE_SIZE=                  # shrink data/snapshot PVCs for rehearsal (empty = 500Gi prod values)

# --- Images (pack side pins these; see images.txt for the Qdrant pin) ---
IMAGE_SHA=                           # default: git rev-parse HEAD on the pack side
QDRANT_IMAGE=docker.io/qdrant/qdrant:v1.19.0-unprivileged

# --- In-cluster inference (other team's vLLM; this repo does not install it) ---
VLLM_BASE_URL=http://vllm.mainframe-rag.svc:8000
EMBED_BASE_URL=                      # defaults to ${VLLM_BASE_URL%/}/v1
EMBED_MODEL=                         # REQUIRED for deploy/ingest: owned by the vLLM team
DENSE_DIM=                           # REQUIRED: must match EMBED_MODEL output
LLM_BASE_URL=http://litellm.mainframe-rag.svc:4000/v1
LLM_MODEL_REASONING=                 # reasoning model only; empty = /v1/answer stays disabled

# --- Optional cross-encoder reranker (issue #76, default off) ---
# RERANK_ENABLED=false
# RERANK_BASE_URL=                   # defaults to EMBED_BASE_URL
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_ENDPOINT_ORDER=score_first  # gateway native leg first: rerank_first (see probe_gateway.py)

# --- Gateway virtual keys (LiteLLM, all model legs) ---
# The platform gateway requires a virtual key per leg. Keys NEVER live in
# this file (scripts refuse plaintext LLM/EMBED/RERANK/CONTEXT_LLM_API_KEY
# assignments): create ONE operator-custodied Secret in $NAMESPACE and name
# it here; deploy/ingest render it via secretKeyRef (unset = keyless).
#   kubectl -n mainframe-rag create secret generic gateway-api-keys \
#     --from-literal=llm-api-key='<sk-...>' \
#     --from-literal=embed-api-key='<sk-...>' \
#     --from-literal=rerank-api-key='<sk-...>' \
#     --from-literal=context-llm-api-key='<sk-...>'
# The agent reads the llm/embed/rerank keys; the ingest Job reads the
# embed/context keys. Rotate by updating the Secret, then rollout restart
# the agent (or re-run the ingest Job). Plaintext keys stay usable for local
# `make ask` via process env — they just can never enter manifests.
#GATEWAY_API_KEY_SECRET=gateway-api-keys

# --- Optional ingest: contextual retrieval prefixes (issue #78, default off) ---
# Enabling changes every dense vector: recreate the collection on first use.
#CONTEXTUAL_EMBED_ENABLED=false
#CONTEXT_LLM_BASE_URL=               # cheap chat model for per-chunk gists (not the reasoning model)
#CONTEXT_LLM_MODEL=

# --- Optional tracing (issue #83, default off) ---
# Set to deploy Jaeger v2 and wire tracing into the agent:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# Optional deploy identity on every span (service.version is IMAGE_SHA
# automatically; deployment.environment is omitted when unset; service.name
# defaults to "mainframe-rag-agent" when unset):
# OTEL_DEPLOYMENT_ENVIRONMENT=prod
#OTEL_SERVICE_NAME=my-rag-prod

# --- Optional metrics (issue #187, default off) ---
# true => serve Prometheus exposition on GET /metrics and deploy the
# ServiceMonitor for user-workload-monitoring scrapes. Cluster prerequisite
# (cluster-admin): UWM enabled and the namespace labeled for UWM discovery.
# METRICS_ENABLED=true

# --- Prod agent extras ---
AGENT_ROUTE=false                    # true => create an edge Route to the agent (default: ClusterIP only)

# --- Optional ingest (make airgap-ingest) ---
CORPUS_PVC=                          # REQUIRED for ingest: caller-supplied PVC, mounted read-only
INGEST_WORKERS=4                     # CPU workers for parallel PDF ingest (default: 4)
INGEST_TIMEOUT=3600                  # seconds to wait for the ingest Job
# INGEST_WORK_SIZE=100Gi              # ingest-work scratch PVC (empty = 100Gi prod default; shrink for rehearsal)
# QDRANT_URL / QDRANT_API_KEY: derived or chart-created; never in this file.

# --- Forbid list (scripts refuse these) ---
# EMBED_MODE=hash is CI/dev only: pack/load/deploy/ingest all refuse it.
# LLM_API_KEY / EMBED_API_KEY / RERANK_API_KEY / CONTEXT_LLM_API_KEY with a
# value are refused in this file: keys live only in the cluster Secret named
# by GATEWAY_API_KEY_SECRET (see above).
