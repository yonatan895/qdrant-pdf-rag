# airgap.env.example
#
# Copy to airgap.env on the connected host and fill in. NEVER commit airgap.env.
# Values here are placeholders: do not guess registry hostnames, storage classes,
# or model names. Open questions live in docs/architecture.md section 5.7.
#
# --- Internal registry (owned by the cluster team) ---
REGISTRY_INTERNAL=registry.example.internal/mainframe-rag
PULL_SECRET=qdrant-pull-secret          # secret name in the target namespace
STORAGE_CLASS=                          # RWO block StorageClass; must NOT be NFS
SNAPSHOT_STORAGE_CLASS=                 # optional; falls back to STORAGE_CLASS

# --- Target cluster ---
OPENSHIFT_NAMESPACE=mainframe-rag
QDRANT_RELEASE=qdrant

# --- Qdrant image (pin digest in images.txt after first pull) ---
QDRANT_IMAGE=docker.io/qdrant/qdrant:v1.19.0-unprivileged
QDRANT_TAG=v1.19.0-unprivileged

# --- Ingest / agent images (built by make build-images) ---
INGEST_IMAGE=${REGISTRY_INTERNAL}/mainframe-rag/ingest:latest
AGENT_IMAGE=${REGISTRY_INTERNAL}/mainframe-rag/agent:latest

# --- Qdrant endpoint (in-cluster) ---
QDRANT_URL=http://qdrant.mainframe-rag.svc:6333
QDRANT_COLLECTION=mainframe_manuals
# QDRANT_API_KEY / QDRANT_READ_ONLY_API_KEY: never in this file; use cluster secrets.

# --- Embedding service (other team's vLLM; OpenAI-compatible) ---
EMBED_BASE_URL=http://vllm.mainframe-rag.svc:8000/v1
EMBED_MODEL=                            # OPEN QUESTION 5.7.1: name from owning team
DENSE_DIM=                              # OPEN QUESTION 5.7.1: must match model output

# --- Reasoning LLM (other team's LiteLLM) ---
LLM_BASE_URL=http://litellm.mainframe-rag.svc:4000/v1
LLM_MODEL_REASONING=                    # OPEN QUESTION 5.7.2: thinking model only

# --- Splunk (optional context; agent does not query Splunk in v1) ---
SPLUNK_HEC_URL=
SPLUNK_TOKEN_SECRET=                    # secret name only

# --- Bundle packing ---
BUNDLE_DIR=bundles
IMAGE_ARCHIVE=qdrant-image.tar
