# airgap.env.example
#
# Copy to airgap.env on the connected host and fill in. NEVER commit airgap.env.
# scripts/airgap/*.sh source this file (make airgap-*) and fail closed on
# missing required keys, EMBED_MODE=hash, or NFS-looking storage classes.
# Values here are placeholders only: no real registries, namespaces, or URLs.

# --- Internal registry (push from air-gap, pulled in-cluster) ---
INTERNAL_REGISTRY=registry.example.internal/mainframe-rag
# Legacy alias accepted by scripts if INTERNAL_REGISTRY is unset:
# REGISTRY_INTERNAL=...

# --- Target namespace / cluster ---
NAMESPACE=mainframe-rag              # legacy alias: OPENSHIFT_NAMESPACE
QDRANT_RELEASE=qdrant                # helm release + service name + apikey secret prefix
STORAGE_CLASS=                       # REQUIRED: RWO block; NFS is refused
SNAPSHOT_STORAGE_CLASS=              # optional; falls back to STORAGE_CLASS
PULL_SECRET=                         # optional secret name if the namespace cannot pull anonymously

# --- Images (pack side pins these; see images.txt for the Qdrant pin) ---
IMAGE_SHA=                           # default: git rev-parse HEAD on the pack side
QDRANT_IMAGE=docker.io/qdrant/qdrant:v1.19.0-unprivileged

# --- In-cluster inference (other team's vLLM; this repo does not install it) ---
VLLM_BASE_URL=http://vllm.mainframe-rag.svc:8000
EMBED_BASE_URL=                      # defaults to ${VLLM_BASE_URL%/}/v1
EMBED_MODEL=                         # REQUIRED for deploy/ingest: owned by the vLLM team
DENSE_DIM=                           # REQUIRED: must match EMBED_MODEL output
LLM_BASE_URL=http://litellm.mainframe-rag.svc:4000/v1
LLM_MODEL_REASONING=                 # reasoning model only; empty = /v1/answer stays disabled

# --- Prod agent extras ---
AGENT_ROUTE=false                    # true => create an edge Route to the agent (default: ClusterIP only)

# --- Optional ingest (make airgap-ingest) ---
CORPUS_PVC=                          # REQUIRED for ingest: caller-supplied PVC, mounted read-only
INGEST_TIMEOUT=3600                  # seconds to wait for the ingest Job
# QDRANT_URL / QDRANT_API_KEY: derived or chart-created; never in this file.

# --- Forbid list (scripts refuse these) ---
# EMBED_MODE=hash is CI/dev only: pack/load/deploy/ingest all refuse it.
